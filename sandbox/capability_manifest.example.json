{
  "schema_version": "1.0",
  "default_deny": true,
  "roles": {
    "collector": {
      "network": {"mode": "allowlist", "hosts": ["api.github.com"], "methods": ["GET"]},
      "ground_truth_access": {"train": "isolated_write_only", "dev": "isolated_write_only", "test": "isolated_write_only"},
      "mounts": [
        {"source_id": "policy:task_input", "target": "/workspace/input/collection-plan", "access": "ro", "class": "task_input"},
        {"source_id": "policy:isolated_raw_dataset", "target": "/workspace/isolated/raw", "access": "wo", "class": "isolated_raw_dataset"}
      ],
      "secrets": ["github_read_token"],
      "external_write": false,
      "tools": ["github_read_proxy"]
    },
    "train_evidence_miner": {
      "network": {"mode": "none", "hosts": [], "methods": []},
      "ground_truth_access": {"train": "read", "dev": "none", "test": "none"},
      "mounts": [
        {"source_id": "policy:train_ground_truth", "target": "/workspace/protected/train", "access": "ro", "class": "train_ground_truth"},
        {"source_id": "policy:derived_evidence", "target": "/workspace/output/train-evidence", "access": "rw", "class": "derived_evidence"}
      ],
      "secrets": [],
      "external_write": false,
      "tools": ["local_analyzer"]
    },
    "candidate_worker": {
      "network": {"mode": "none", "hosts": [], "methods": []},
      "ground_truth_access": {"train": "derived_only", "dev": "none", "test": "none"},
      "mounts": [
        {"source_id": "policy:derived_evidence", "target": "/workspace/input/train-derived", "access": "ro", "class": "derived_evidence"},
        {"source_id": "policy:candidate_staging", "target": "/workspace/output/candidate", "access": "rw", "class": "candidate_staging"}
      ],
      "secrets": [],
      "external_write": false,
      "tools": ["candidate_editor"]
    },
    "judge": {
      "network": {"mode": "none", "hosts": [], "methods": []},
      "ground_truth_access": {"train": "none", "dev": "none", "test": "none"},
      "mounts": [
        {"source_id": "policy:sanitized_judge_input", "target": "/workspace/input/judge", "access": "ro", "class": "sanitized_judge_input"},
        {"source_id": "policy:judge_output", "target": "/workspace/output/judge", "access": "wo", "class": "judge_output"}
      ],
      "secrets": [],
      "external_write": false,
      "tools": []
    },
    "artifact_evaluator": {
      "network": {"mode": "none", "hosts": [], "methods": []},
      "ground_truth_access": {"train": "none", "dev": "none", "test": "none"},
      "mounts": [
        {"source_id": "policy:candidate_artifacts", "target": "/workspace/input/artifacts", "access": "ro", "class": "candidate_artifacts"},
        {"source_id": "policy:artifact_gate_results", "target": "/workspace/output/artifact-gates", "access": "wo", "class": "artifact_gate_results"}
      ],
      "secrets": [],
      "external_write": false,
      "tools": ["schema_validator", "leakage_scanner"]
    },
    "dev_evaluator": {
      "network": {"mode": "none", "hosts": [], "methods": []},
      "ground_truth_access": {"train": "none", "dev": "read", "test": "none"},
      "mounts": [
        {"source_id": "policy:dev_ground_truth", "target": "/workspace/protected/dev", "access": "ro", "class": "dev_ground_truth"},
        {"source_id": "policy:frozen_candidate", "target": "/workspace/input/dev-candidate", "access": "ro", "class": "frozen_candidate"},
        {"source_id": "policy:bounded_dev_diagnostics", "target": "/workspace/output/dev-diagnostics", "access": "wo", "class": "bounded_dev_diagnostics"}
      ],
      "secrets": [],
      "external_write": false,
      "tools": ["protected_scorer"]
    },
    "final_test_evaluator": {
      "network": {"mode": "none", "hosts": [], "methods": []},
      "ground_truth_access": {"train": "none", "dev": "none", "test": "read"},
      "mounts": [
        {"source_id": "policy:test_ground_truth", "target": "/workspace/protected/test", "access": "ro", "class": "test_ground_truth"},
        {"source_id": "policy:frozen_candidate", "target": "/workspace/input/frozen-candidate", "access": "ro", "class": "frozen_candidate"},
        {"source_id": "policy:final_test_checkpoint", "target": "/workspace/output/final-test", "access": "rw", "class": "final_test_checkpoint"}
      ],
      "secrets": [],
      "external_write": false,
      "tools": ["protected_scorer", "final_test_barrier"]
    },
    "untrusted_code_runner": {
      "network": {"mode": "none", "hosts": [], "methods": []},
      "ground_truth_access": {"train": "none", "dev": "none", "test": "none"},
      "mounts": [
        {"source_id": "policy:untrusted_source", "target": "/workspace/source", "access": "ro", "class": "untrusted_source"},
        {"source_id": "policy:runner_output", "target": "/workspace/output", "access": "rw", "class": "runner_output"}
      ],
      "secrets": [],
      "external_write": false,
      "tools": ["sandbox_exec"],
      "controls": {
        "rootless": true,
        "read_only_rootfs": true,
        "no_new_privileges": true,
        "cap_drop": ["ALL"],
        "user_uid": 65532,
        "resources": {"cpus": 1, "memory_mb": 1024, "pids": 128, "disk_mb": 512, "wall_seconds": 600}
      }
    }
  }
}
