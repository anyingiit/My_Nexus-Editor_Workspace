# syntax=docker/dockerfile:1.7
# The caller MUST pass a digest-pinned image, for example:
#   --build-arg BASE_IMAGE=registry.example/safe-runner@sha256:<64 hex>
ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Numeric identity avoids relying on mutable image account databases.
USER 65532:65532
WORKDIR /workspace/source
ENV HOME=/nonexistent \
    XDG_CONFIG_HOME=/nonexistent \
    XDG_CACHE_HOME=/tmp/cache \
    NO_COLOR=1

# Runtime isolation is enforced by run-untrusted.sh, not by this file alone.
CMD ["/bin/sh", "-lc", "exit 64"]
