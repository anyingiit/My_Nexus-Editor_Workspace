{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents-v3/artifact_manifest.schema.json",
  "title": "Promotable artifact manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "artifact_id",
    "artifact_type",
    "producer_task_id",
    "created_at",
    "staging_path",
    "canonical_path",
    "sha256",
    "size_bytes",
    "source_artifacts",
    "provenance",
    "knowledge_cutoff",
    "contains_protected_truth",
    "deterministic_checks",
    "semantic_gate",
    "promotion_status"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "artifact_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "artifact_type": {"type": "string", "minLength": 1, "maxLength": 128},
    "producer_task_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "created_at": {"type": "string", "format": "date-time"},
    "staging_path": {"type": "string", "minLength": 1},
    "canonical_path": {"type": ["string", "null"], "minLength": 1},
    "sha256": {"$ref": "#/$defs/sha256"},
    "size_bytes": {"type": "integer", "minimum": 0},
    "source_artifacts": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}, "uniqueItems": true},
    "provenance": {"$ref": "#/$defs/provenance"},
    "knowledge_cutoff": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "contains_protected_truth": {"type": "boolean"},
    "deterministic_checks": {"type": "array", "items": {"$ref": "#/$defs/check"}, "uniqueItems": true},
    "semantic_gate": {"enum": ["NOT_REQUIRED", "PENDING", "PASSED", "FAILED"]},
    "promotion_status": {"enum": ["STAGED", "REJECTED", "PROMOTED"]}
  },
  "allOf": [
    {
      "if": {"properties": {"promotion_status": {"const": "PROMOTED"}}},
      "then": {
        "properties": {
          "canonical_path": {"type": "string", "minLength": 1},
          "deterministic_checks": {"type": "array", "minItems": 8},
          "semantic_gate": {"enum": ["NOT_REQUIRED", "PASSED"]}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "sha256"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_type", "producer_role", "source_revision", "source_sha256", "observed_at", "knowledge_available_at", "derivation_sha256"],
      "properties": {
        "source_type": {"enum": ["GENERATED", "COLLECTED", "DERIVED", "IMPORTED"]},
        "producer_role": {"type": "string", "minLength": 1},
        "source_revision": {"type": ["string", "null"], "minLength": 1},
        "source_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "observed_at": {"type": "string", "format": "date-time"},
        "knowledge_available_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "derivation_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "details_sha256"],
      "properties": {
        "name": {"enum": ["SCHEMA", "PATH_ALLOWLIST", "REFERENCE_EXISTENCE", "COUNT", "CHECKSUM", "LEAKAGE_SCAN", "KNOWLEDGE_CUTOFF", "PROVENANCE"]},
        "status": {"enum": ["PASSED", "FAILED"]},
        "details_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
