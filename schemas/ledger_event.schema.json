{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents-v3/ledger_event.schema.json",
  "title": "Canonical append-only ledger event envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "sequence", "event_id", "event_type", "timestamp", "actor_role", "entity_type", "entity_id", "idempotency_key", "previous_event_sha256", "payload", "payload_sha256", "event_sha256"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "event_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "actor_role": {"type": "string", "minLength": 1},
    "entity_type": {"type": "string", "minLength": 1},
    "entity_id": {"type": "string", "minLength": 1},
    "idempotency_key": {"type": "string", "minLength": 1},
    "previous_event_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"const": "GENESIS"}]},
    "payload": {"type": "object"},
    "payload_sha256": {"$ref": "#/$defs/sha256"},
    "event_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
