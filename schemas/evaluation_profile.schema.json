{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents-v3/evaluation_profile.schema.json",
  "title": "Complete immutable evaluation profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "run_id",
    "frozen",
    "frozen_at",
    "profile_sha256",
    "preregistration_sha256",
    "protocol_manifest_sha256",
    "schema_manifest_sha256",
    "candidate",
    "baselines",
    "knowledge",
    "dataset",
    "judge",
    "packing",
    "retrieval",
    "execution",
    "analysis",
    "runtime"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "profile_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "frozen": {"type": "boolean"},
    "frozen_at": {"anyOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "profile_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "preregistration_sha256": {"$ref": "#/$defs/sha256"},
    "protocol_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "schema_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "baselines": {"$ref": "#/$defs/baselines"},
    "knowledge": {"$ref": "#/$defs/knowledge"},
    "dataset": {"$ref": "#/$defs/dataset"},
    "judge": {"$ref": "#/$defs/judge"},
    "packing": {"$ref": "#/$defs/packing"},
    "retrieval": {"$ref": "#/$defs/retrieval"},
    "execution": {"$ref": "#/$defs/execution"},
    "analysis": {"$ref": "#/$defs/analysis"},
    "runtime": {"$ref": "#/$defs/runtime"}
  },
  "allOf": [
    {
      "if": {"properties": {"frozen": {"const": true}}},
      "then": {
        "properties": {
          "frozen_at": {"type": "string", "format": "date-time"},
          "profile_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {"properties": {"frozen": {"const": false}}},
      "then": {
        "properties": {
          "frozen_at": {"type": "null"},
          "profile_sha256": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_sha256", "annex_manifest_sha256", "artifact_manifest_sha256"],
      "properties": {
        "core_sha256": {"$ref": "#/$defs/sha256"},
        "annex_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "artifact_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "baselines": {
      "type": "object",
      "additionalProperties": false,
      "required": ["empty_sha256", "repository_sha256"],
      "properties": {
        "empty_sha256": {"$ref": "#/$defs/sha256"},
        "repository_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cutoff", "source_manifest_sha256", "direct_commit_manifest_sha256", "third_party_manifest_sha256"],
      "properties": {
        "cutoff": {"type": "string", "format": "date-time"},
        "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "direct_commit_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "third_party_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["eligibility_manifest_sha256", "split_manifest_sha256", "grouping_manifest_sha256", "snapshot_manifest_sha256", "ci_manifest_sha256", "rubric_manifest_sha256"],
      "properties": {
        "eligibility_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "split_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "grouping_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "snapshot_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "ci_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "rubric_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "judge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "model", "deployment_version", "system_prompt_sha256", "user_prompt_template_sha256", "output_schema_sha256", "temperature", "top_p", "seed", "max_output_tokens", "stop"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "deployment_version": {"type": "string", "minLength": 1},
        "system_prompt_sha256": {"$ref": "#/$defs/sha256"},
        "user_prompt_template_sha256": {"$ref": "#/$defs/sha256"},
        "output_schema_sha256": {"$ref": "#/$defs/sha256"},
        "temperature": {"type": "number", "minimum": 0},
        "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "seed": {"type": "integer"},
        "max_output_tokens": {"type": "integer", "minimum": 1},
        "stop": {"type": "array", "items": {"type": "string"}}
      }
    },
    "packing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "implementation_sha256", "max_input_tokens", "truncation_policy", "ordering_policy"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "max_input_tokens": {"type": "integer", "minimum": 1},
        "truncation_policy": {"type": "string", "minLength": 1},
        "ordering_policy": {"type": "string", "minLength": 1}
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation", "corpus_sha256", "algorithm_sha256", "tie_breaking", "selection_manifest_sha256"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "corpus_sha256": {"$ref": "#/$defs/sha256"},
        "algorithm_sha256": {"$ref": "#/$defs/sha256"},
        "tie_breaking": {"type": "string", "minLength": 1},
        "selection_manifest_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arms", "arm_order_seed", "repeats", "vote_policy", "retry_policy_sha256", "canonical_result_policy", "cache_key_version", "cache_namespace"],
      "properties": {
        "arms": {"const": ["EMPTY", "REPO_BASELINE", "CANDIDATE"]},
        "arm_order_seed": {"type": "integer"},
        "repeats": {"type": "integer", "minimum": 1},
        "vote_policy": {"enum": ["FIRST_CANONICAL", "MAJORITY_TIE_REQUEST_CHANGES"]},
        "retry_policy_sha256": {"$ref": "#/$defs/sha256"},
        "canonical_result_policy": {"const": "LOWEST_SUCCESSFUL_ATTEMPT_WITHOUT_LABEL_ACCESS"},
        "cache_key_version": {"type": "string", "minLength": 1},
        "cache_namespace": {"type": "string", "minLength": 1}
      }
    },
    "analysis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_sha256", "alpha", "target_power", "bootstrap_resamples", "bootstrap_seed", "min_effect_pp", "decision_accuracy_floor", "reject_recall_floor", "balanced_accuracy_floor", "multiplicity", "require_adjusted_significance", "required_effective_groups", "required_sample_count", "required_reject_count", "required_approve_count", "ci_pass_subset_role"],
      "properties": {
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "target_power": {"type": "number", "exclusiveMinimum": 0.5, "exclusiveMaximum": 1},
        "bootstrap_resamples": {"type": "integer", "minimum": 1000},
        "bootstrap_seed": {"type": "integer"},
        "min_effect_pp": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "decision_accuracy_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "reject_recall_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "balanced_accuracy_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "multiplicity": {"const": "HOLM_TWO_BASELINES"},
        "require_adjusted_significance": {"const": true},
        "required_effective_groups": {"type": "integer", "minimum": 1},
        "required_sample_count": {"type": "integer", "minimum": 1},
        "required_reject_count": {"type": "integer", "minimum": 1},
        "required_approve_count": {"type": "integer", "minimum": 1},
        "ci_pass_subset_role": {"enum": ["DIAGNOSTIC", "CO_PRIMARY"]}
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["harness_commit", "harness_tree_sha256", "dependency_lock_sha256", "runtime_version", "sandbox_image_digest", "capability_manifest_sha256", "runtime_capability_report_sha256", "run_config_sha256", "truth_vault_version_sha256"],
      "properties": {
        "harness_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
        "harness_tree_sha256": {"$ref": "#/$defs/sha256"},
        "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_version": {"type": "string", "minLength": 1},
        "sandbox_image_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "capability_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "runtime_capability_report_sha256": {"$ref": "#/$defs/sha256"},
        "run_config_sha256": {"$ref": "#/$defs/sha256"},
        "truth_vault_version_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
