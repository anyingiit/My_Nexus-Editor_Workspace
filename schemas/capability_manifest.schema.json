{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents-v3/capability_manifest.schema.json",
  "title": "Static Role Capability Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "default_deny", "roles"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "default_deny": {"const": true},
    "roles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collector", "train_evidence_miner", "candidate_worker", "judge", "artifact_evaluator", "dev_evaluator", "final_test_evaluator", "untrusted_code_runner"],
      "properties": {
        "collector": {"$ref": "#/$defs/role"},
        "train_evidence_miner": {"$ref": "#/$defs/role"},
        "candidate_worker": {"$ref": "#/$defs/role"},
        "judge": {"$ref": "#/$defs/role"},
        "artifact_evaluator": {"$ref": "#/$defs/role"},
        "dev_evaluator": {"$ref": "#/$defs/role"},
        "final_test_evaluator": {"$ref": "#/$defs/role"},
        "untrusted_code_runner": {"$ref": "#/$defs/role"}
      }
    }
  },
  "$defs": {
    "role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["network", "ground_truth_access", "mounts", "secrets", "external_write", "tools"],
      "properties": {
        "network": {"$ref": "#/$defs/network"},
        "ground_truth_access": {"$ref": "#/$defs/truthAccess"},
        "mounts": {"type": "array", "items": {"$ref": "#/$defs/mount"}},
        "secrets": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "external_write": {"const": false},
        "tools": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "controls": {"$ref": "#/$defs/controls"}
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "hosts", "methods"],
      "properties": {"mode": {"enum": ["none", "allowlist"]}, "hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "methods": {"type": "array", "uniqueItems": true, "items": {"enum": ["GET", "POST"]}}}
    },
    "truthAccess": {
      "type": "object", "additionalProperties": false,
      "required": ["train", "dev", "test"],
      "properties": {"train": {"enum": ["none", "read", "derived_only", "isolated_write_only"]}, "dev": {"enum": ["none", "read", "isolated_write_only"]}, "test": {"enum": ["none", "read", "isolated_write_only"]}}
    },
    "mount": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "target", "access", "class"],
      "properties": {"source_id": {"type": "string", "minLength": 1}, "target": {"type": "string", "pattern": "^/"}, "access": {"enum": ["ro", "wo", "rw"]}, "class": {"type": "string", "minLength": 1}}
    },
    "controls": {
      "type": "object", "additionalProperties": false,
      "required": ["rootless", "read_only_rootfs", "no_new_privileges", "cap_drop", "user_uid", "resources"],
      "properties": {
        "rootless": {"const": true}, "read_only_rootfs": {"const": true}, "no_new_privileges": {"const": true},
        "cap_drop": {"type": "array", "contains": {"const": "ALL"}}, "user_uid": {"type": "integer", "minimum": 1},
        "resources": {
          "type": "object", "additionalProperties": false,
          "required": ["cpus", "memory_mb", "pids", "disk_mb", "wall_seconds"],
          "properties": {"cpus": {"type": "number", "exclusiveMinimum": 0}, "memory_mb": {"type": "integer", "minimum": 64}, "pids": {"type": "integer", "minimum": 1}, "disk_mb": {"type": "integer", "minimum": 1}, "wall_seconds": {"type": "integer", "minimum": 1}}
        }
      }
    }
  }
}
