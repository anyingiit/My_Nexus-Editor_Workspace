{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents-v3/agent_in_loop_result.schema.json",
  "title": "Blinded Agent-in-the-loop Result",
  "type": "object",
  "additionalProperties": false,
  "required": ["blind_task_id", "coding_model_hash", "patch_sha256", "completion_status", "ci_passed", "blind_problem_count", "blind_severity_score", "blind_completion_score", "tokens_used", "wall_seconds", "cash_microusd"],
  "properties": {
    "blind_task_id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
    "coding_model_hash": {"$ref": "#/$defs/sha256"},
    "patch_sha256": {"$ref": "#/$defs/sha256"},
    "completion_status": {"enum": ["COMPLETE", "PARTIAL", "FAILED"]},
    "ci_passed": {"type": "boolean"},
    "blind_problem_count": {"type": "integer", "minimum": 0},
    "blind_severity_score": {"type": "number", "minimum": 0},
    "blind_completion_score": {"type": "number", "minimum": 0, "maximum": 1},
    "tokens_used": {"type": "integer", "minimum": 0},
    "wall_seconds": {"type": "integer", "minimum": 0},
    "cash_microusd": {"type": "integer", "minimum": 0}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
