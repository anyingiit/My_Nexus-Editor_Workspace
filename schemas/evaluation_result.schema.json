{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents-v3/evaluation_result.schema.json",
  "title": "Canonical per-sample, per-arm, per-repeat evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "profile_sha256", "sample_id", "split_group_id", "arm", "repeat_index", "cache_key", "packed_input_sha256", "decision", "reasons", "schema_valid", "truncated", "provider_request_id", "usage", "latency_ms", "attempt", "canonical", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "profile_sha256": {"$ref": "#/$defs/sha256"},
    "sample_id": {"type": "string", "minLength": 1},
    "split_group_id": {"type": "string", "minLength": 1},
    "arm": {"enum": ["EMPTY", "REPO_BASELINE", "CANDIDATE"]},
    "repeat_index": {"type": "integer", "minimum": 0},
    "cache_key": {"type": "string", "minLength": 1},
    "packed_input_sha256": {"$ref": "#/$defs/sha256"},
    "decision": {"enum": ["APPROVE", "REQUEST_CHANGES"]},
    "reasons": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason_id", "text"],
        "properties": {
          "reason_id": {"type": "string", "minLength": 1, "maxLength": 256},
          "text": {"type": "string", "minLength": 1, "maxLength": 4000}
        }
      }
    },
    "schema_valid": {"const": true},
    "truncated": {"const": false},
    "provider_request_id": {"type": ["string", "null"]},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "cash_usd", "provider_quota"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "cash_usd": {"type": "number", "minimum": 0},
        "provider_quota": {"type": "number", "minimum": 0}
      }
    },
    "latency_ms": {"type": "integer", "minimum": 0},
    "attempt": {"type": "integer", "minimum": 1},
    "canonical": {"const": true},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
