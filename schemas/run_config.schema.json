{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents-v3/run_config.schema.json",
  "title": "AGENTS V3 Run Configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "mode", "dependency_lock_sha256", "approval", "time", "tokens",
    "cash_usd", "provider_quota", "tool_calls", "stage_caps", "iteration",
    "concurrency", "status", "retry", "providers", "dataset", "metrics",
    "statistics", "stability", "sandbox", "final_test"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "run_id": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9._-]+$"},
    "mode": {"enum": ["demo", "probe", "development", "final"]},
    "dependency_lock_sha256": {"$ref": "#/$defs/sha256"},
    "approval": {
      "type": "object", "additionalProperties": false,
      "required": ["confirmed", "confirmed_by", "confirmed_at", "manifest_sha256"],
      "properties": {
        "confirmed": {"type": "boolean"},
        "confirmed_by": {"type": ["string", "null"], "minLength": 1},
        "confirmed_at": {"type": ["string", "null"], "format": "date-time"},
        "manifest_sha256": {"$ref": "#/$defs/nullableSha256"}
      }
    },
    "time": {
      "type": "object", "additionalProperties": false,
      "required": ["deadline_at", "max_wall_clock_seconds", "soft_watermark_seconds", "closeout_reserve_seconds"],
      "properties": {
        "deadline_at": {"type": "string", "format": "date-time"},
        "max_wall_clock_seconds": {"type": "integer", "minimum": 1},
        "soft_watermark_seconds": {"type": "integer", "minimum": 1},
        "closeout_reserve_seconds": {"type": "integer", "minimum": 1}
      }
    },
    "tokens": {"$ref": "#/$defs/integerBudget"},
    "cash_usd": {
      "type": "object", "additionalProperties": false,
      "required": ["max_incremental", "soft_watermark", "closeout_reserve"],
      "properties": {
        "max_incremental": {"type": "number", "exclusiveMinimum": 0},
        "soft_watermark": {"type": "number", "minimum": 0},
        "closeout_reserve": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "provider_quota": {
      "type": "object", "additionalProperties": false,
      "required": ["unit", "max_total", "soft_watermark", "closeout_reserve"],
      "properties": {
        "unit": {"const": "usd_equivalent"},
        "max_total": {"type": "number", "exclusiveMinimum": 0},
        "soft_watermark": {"type": "number", "minimum": 0},
        "closeout_reserve": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "tool_calls": {"$ref": "#/$defs/integerBudget"},
    "stage_caps": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "census", "vertical_slice", "dev", "freeze_test", "closeout"],
      "properties": {
        "protocol": {"$ref": "#/$defs/stageCap"},
        "census": {"$ref": "#/$defs/stageCap"},
        "vertical_slice": {"$ref": "#/$defs/stageCap"},
        "dev": {"$ref": "#/$defs/stageCap"},
        "freeze_test": {"$ref": "#/$defs/stageCap"},
        "closeout": {"$ref": "#/$defs/stageCap"}
      }
    },
    "iteration": {
      "type": "object", "additionalProperties": false,
      "required": ["max_dev_iterations", "low_gain_patience", "min_dev_gain_pp", "max_cash_per_gain_pp"],
      "properties": {
        "max_dev_iterations": {"type": "integer", "minimum": 1},
        "low_gain_patience": {"type": "integer", "minimum": 1},
        "min_dev_gain_pp": {"type": "number", "minimum": 0},
        "max_cash_per_gain_pp": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "concurrency": {
      "type": "object", "additionalProperties": false,
      "required": ["max_total_slots", "max_worker_slots", "evaluator_consumes_slot", "min_slots", "rate_limit_backoff_threshold", "failure_rate_reduce_threshold"],
      "properties": {
        "max_total_slots": {"type": "integer", "minimum": 1},
        "max_worker_slots": {"type": "integer", "minimum": 1},
        "evaluator_consumes_slot": {"type": "boolean"},
        "min_slots": {"type": "integer", "minimum": 1},
        "rate_limit_backoff_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "failure_rate_reduce_threshold": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "status": {
      "type": "object", "additionalProperties": false,
      "required": ["max_staleness_seconds", "heartbeat_seconds", "lease_seconds"],
      "properties": {
        "max_staleness_seconds": {"type": "integer", "minimum": 1},
        "heartbeat_seconds": {"type": "integer", "minimum": 1},
        "lease_seconds": {"type": "integer", "minimum": 2}
      }
    },
    "retry": {
      "type": "object", "additionalProperties": false,
      "required": ["max_attempts", "base_backoff_seconds", "max_backoff_seconds", "retryable_classes", "nonretryable_classes"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1},
        "base_backoff_seconds": {"type": "integer", "minimum": 0},
        "max_backoff_seconds": {"type": "integer", "minimum": 0},
        "retryable_classes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/errorClass"}},
        "nonretryable_classes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/errorClass"}}
      }
    },
    "providers": {
      "type": "object", "additionalProperties": false,
      "required": ["evaluation", "non_evaluation"],
      "properties": {
        "evaluation": {
          "allOf": [{"$ref": "#/$defs/providerLimit"}],
          "properties": {"automatic_failover": {"const": false}},
          "required": ["automatic_failover"]
        },
        "non_evaluation": {
          "type": "object", "additionalProperties": false,
          "required": ["allowed", "max_input_tokens_per_call", "max_output_tokens_per_call", "max_cash_usd_per_call"],
          "properties": {
            "allowed": {
              "type": "array", "minItems": 1,
              "items": {
                "type": "object", "additionalProperties": false,
                "required": ["provider", "model"],
                "properties": {"provider": {"type": "string", "minLength": 1}, "model": {"type": "string", "minLength": 1}}
              }
            },
            "max_input_tokens_per_call": {"type": "integer", "minimum": 1},
            "max_output_tokens_per_call": {"type": "integer", "minimum": 1},
            "max_cash_usd_per_call": {"type": "number", "exclusiveMinimum": 0}
          }
        }
      }
    },
    "dataset": {
      "type": "object", "additionalProperties": false,
      "required": ["train_ratio", "dev_ratio", "test_ratio", "event_selection", "knowledge_cutoff", "near_duplicate_threshold", "hide_repository_identifiers"],
      "properties": {
        "train_ratio": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "dev_ratio": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "test_ratio": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "event_selection": {"const": "EARLIEST_QUALIFIED_MAINTAINER_REVIEW"},
        "knowledge_cutoff": {"type": ["string", "null"], "format": "date-time"},
        "near_duplicate_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "hide_repository_identifiers": {"const": true}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["decision_accuracy_floor", "reject_recall_floor", "balanced_accuracy_floor", "min_effect_pp", "ci_pass_subset_is_coprimary"],
      "properties": {
        "decision_accuracy_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "reject_recall_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "balanced_accuracy_floor": {"type": "number", "minimum": 0, "maximum": 1},
        "min_effect_pp": {"type": "number", "exclusiveMinimum": 0, "maximum": 100},
        "ci_pass_subset_is_coprimary": {"type": "boolean"}
      }
    },
    "statistics": {
      "type": "object", "additionalProperties": false,
      "required": ["alpha", "target_power", "bootstrap_resamples", "bootstrap_seed", "paired_test", "multiplicity", "insufficient_sample_terminal"],
      "properties": {
        "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "target_power": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
        "bootstrap_resamples": {"type": "integer", "minimum": 1000},
        "bootstrap_seed": {"type": "integer"},
        "paired_test": {"const": "EXACT_MCNEMAR"},
        "multiplicity": {"const": "HOLM_TWO_BASELINES"},
        "insufficient_sample_terminal": {"const": "INCONCLUSIVE"}
      }
    },
    "stability": {
      "type": "object", "additionalProperties": false,
      "required": ["repeats", "subset_size", "low_pairwise_agreement_threshold", "diagnostic_only"],
      "properties": {
        "repeats": {"type": "integer", "minimum": 2},
        "subset_size": {"type": "integer", "minimum": 2},
        "low_pairwise_agreement_threshold": {"type": "number", "minimum": 0, "maximum": 1},
        "diagnostic_only": {"const": true}
      }
    },
    "sandbox": {
      "type": "object", "additionalProperties": false,
      "required": ["untrusted_code_execution", "require_rootless", "network", "read_only_rootfs", "no_new_privileges", "launcher_attestation_key_sha256", "max_cpus", "max_memory_mb", "max_pids", "max_disk_mb", "max_output_mb", "max_wall_clock_seconds_per_job"],
      "properties": {
        "untrusted_code_execution": {"enum": ["disabled", "enabled_after_capability_gate"]},
        "require_rootless": {"const": true},
        "network": {"const": "none"},
        "read_only_rootfs": {"const": true},
        "no_new_privileges": {"const": true},
        "launcher_attestation_key_sha256": {"$ref": "#/$defs/sha256"},
        "max_cpus": {"type": "number", "exclusiveMinimum": 0},
        "max_memory_mb": {"type": "integer", "minimum": 64},
        "max_pids": {"type": "integer", "minimum": 1},
        "max_disk_mb": {"type": "integer", "minimum": 1},
        "max_output_mb": {"type": "integer", "minimum": 1},
        "max_wall_clock_seconds_per_job": {"type": "integer", "minimum": 1}
      }
    },
    "final_test": {
      "type": "object", "additionalProperties": false,
      "required": ["run_once", "immutable_profile_required", "resumable_same_profile", "repair_after_valid_test"],
      "properties": {
        "run_once": {"const": true},
        "immutable_profile_required": {"const": true},
        "resumable_same_profile": {"const": true},
        "repair_after_valid_test": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "demo"}}, "required": ["mode"]},
      "then": {
        "properties": {
          "sandbox": {"properties": {"untrusted_code_execution": {"const": "disabled"}}},
          "providers": {
            "properties": {
              "evaluation": {"properties": {"provider": {"const": "deterministic_stub"}}},
              "non_evaluation": {
                "properties": {
                  "allowed": {
                    "items": {"properties": {"provider": {"const": "deterministic_stub"}}}
                  }
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "approval": {"properties": {"manifest_sha256": {"$ref": "#/$defs/sha256"}}},
          "dataset": {"properties": {"knowledge_cutoff": {"type": "string", "format": "date-time"}}}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullableSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "integerBudget": {
      "type": "object", "additionalProperties": false,
      "required": ["max_total", "soft_watermark", "closeout_reserve"],
      "properties": {
        "max_total": {"type": "integer", "minimum": 1},
        "soft_watermark": {"type": "integer", "minimum": 0},
        "closeout_reserve": {"type": "integer", "minimum": 1}
      }
    },
    "stageCap": {
      "type": "object", "additionalProperties": false,
      "required": ["max_wall_clock_seconds", "max_tokens", "max_cash_usd", "max_provider_quota_usd", "max_tool_calls"],
      "properties": {
        "max_wall_clock_seconds": {"type": "integer", "minimum": 1},
        "max_tokens": {"type": "integer", "minimum": 0},
        "max_cash_usd": {"type": "number", "minimum": 0},
        "max_provider_quota_usd": {"type": "number", "minimum": 0},
        "max_tool_calls": {"type": "integer", "minimum": 0}
      }
    },
    "providerLimit": {
      "type": "object", "additionalProperties": false,
      "required": ["provider", "model", "max_input_tokens_per_call", "max_output_tokens_per_call", "max_cash_usd_per_call"],
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "max_input_tokens_per_call": {"type": "integer", "minimum": 1},
        "max_output_tokens_per_call": {"type": "integer", "minimum": 1},
        "max_cash_usd_per_call": {"type": "number", "exclusiveMinimum": 0},
        "automatic_failover": {"type": "boolean"}
      }
    },
    "errorClass": {
      "enum": ["TRANSPORT", "RATE_LIMIT", "HTTP_4XX", "HTTP_5XX", "TIMEOUT", "EMPTY_RESPONSE", "TRUNCATED", "CONTEXT_OVERFLOW", "JSON_INVALID", "SCHEMA_INVALID", "SAFETY_REFUSAL", "SEMANTIC_INVALID"]
    }
  }
}
