{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents-v3/knowledge_manifest.schema.json",
  "title": "Knowledge Cutoff and Source Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "knowledge_cutoff", "sources", "sample_groups", "candidate_source_ids", "baseline_source_ids", "memory_contamination_risk"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "manifest_id": {"type": "string", "minLength": 1},
    "knowledge_cutoff": {"type": "string", "format": "date-time"},
    "manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}},
    "sample_groups": {"type": "array", "items": {"$ref": "#/$defs/group"}},
    "candidate_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "baseline_source_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "memory_contamination_risk": {"enum": ["LOW", "MEDIUM", "HIGH", "UNKNOWN"]},
    "memory_probe_report_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commit": {"type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "kind", "origin", "revision", "sha256", "published_at", "available_at", "candidate_visible"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["repository_file", "repository_config", "contributing", "direct_commit", "third_party", "derived_annex"]},
        "origin": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "minLength": 1},
        "commit_sha": {"anyOf": [{"$ref": "#/$defs/commit"}, {"type": "null"}]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "published_at": {"type": "string", "format": "date-time"},
        "available_at": {"type": "string", "format": "date-time"},
        "candidate_visible": {"type": "boolean"}
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "sample_ids", "split", "max_label_event_at", "basis"],
      "properties": {
        "group_id": {"type": "string", "minLength": 1},
        "sample_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "split": {"enum": ["train", "dev", "test"]},
        "max_label_event_at": {"type": "string", "format": "date-time"},
        "basis": {"type": "array", "minItems": 1, "items": {"enum": ["stack", "revert", "shared_issue", "patch_similarity", "manual"]}}
      }
    }
  }
}
