{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents-v3/sample.schema.json",
  "title": "Event-aligned census and decision sample",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sample_id",
    "repository_id",
    "pull_request_group_id",
    "eligibility_cohort",
    "rationale_eligible",
    "observed_review_issue_count",
    "label_event_id",
    "label_event_type",
    "label_timestamp",
    "head_sha_at_event",
    "base_sha_at_event",
    "snapshot_head_sha",
    "snapshot_base_sha",
    "snapshot_manifest_sha256",
    "maintainer_identity_basis",
    "maintainer_evidence_as_of",
    "eligibility_reason",
    "exclusion_reason",
    "split_group_id",
    "grouping_evidence_sha256",
    "split",
    "ground_truth_manifest_sha256",
    "aggregate_ci_status"
  ],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "sample_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "repository_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "pull_request_group_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "eligibility_cohort": {"enum": ["decision", "administrative", "excluded", "unknown"]},
    "rationale_eligible": {"type": "boolean"},
    "observed_review_issue_count": {"type": ["integer", "null"], "minimum": 0},
    "label_event_id": {"type": ["string", "null"], "minLength": 1, "maxLength": 256},
    "label_event_type": {
      "enum": [
        "APPROVE",
        "REQUEST_CHANGES",
        "DUPLICATE",
        "SPAM",
        "SUPERSEDED",
        "ABANDONED",
        "AUTHOR_CLOSED",
        "BOT_ONLY",
        "MERGED_WITHOUT_REVIEW",
        "CLOSED_WITHOUT_REVIEW",
        "NO_QUALIFIED_REVIEW",
        "UNKNOWN"
      ]
    },
    "label_timestamp": {
      "anyOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "head_sha_at_event": {"anyOf": [{"$ref": "#/$defs/commitSha"}, {"type": "null"}]},
    "base_sha_at_event": {"anyOf": [{"$ref": "#/$defs/commitSha"}, {"type": "null"}]},
    "snapshot_head_sha": {"anyOf": [{"$ref": "#/$defs/commitSha"}, {"type": "null"}]},
    "snapshot_base_sha": {"anyOf": [{"$ref": "#/$defs/commitSha"}, {"type": "null"}]},
    "snapshot_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "maintainer_identity_basis": {
      "enum": ["CODEOWNERS", "org_role", "repository_permission", "frozen_allowlist", null]
    },
    "maintainer_evidence_as_of": {
      "anyOf": [
        {"type": "string", "format": "date-time"},
        {"type": "null"}
      ]
    },
    "eligibility_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "exclusion_reason": {"type": ["string", "null"], "minLength": 1, "maxLength": 128},
    "split_group_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "grouping_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "split": {"enum": ["train", "dev", "test", "unassigned"]},
    "ground_truth_manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "aggregate_ci_status": {"enum": ["CI_PASS", "CI_FAIL", "CI_UNKNOWN"]}
  },
  "allOf": [
    {
      "if": {"properties": {"eligibility_cohort": {"const": "decision"}}},
      "then": {
        "properties": {
          "label_event_id": {"type": "string", "minLength": 1},
          "label_event_type": {"enum": ["APPROVE", "REQUEST_CHANGES"]},
          "label_timestamp": {"type": "string", "format": "date-time"},
          "head_sha_at_event": {"$ref": "#/$defs/commitSha"},
          "base_sha_at_event": {"$ref": "#/$defs/commitSha"},
          "snapshot_head_sha": {"$ref": "#/$defs/commitSha"},
          "snapshot_base_sha": {"$ref": "#/$defs/commitSha"},
          "snapshot_manifest_sha256": {"$ref": "#/$defs/sha256"},
          "maintainer_identity_basis": {"enum": ["CODEOWNERS", "org_role", "repository_permission", "frozen_allowlist"]},
          "maintainer_evidence_as_of": {"type": "string", "format": "date-time"},
          "eligibility_reason": {"type": "string", "minLength": 1},
          "exclusion_reason": {"type": "null"},
          "split": {"enum": ["train", "dev", "test"]},
          "ground_truth_manifest_sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    {
      "if": {"properties": {"rationale_eligible": {"const": true}}},
      "then": {
        "properties": {
          "eligibility_cohort": {"const": "decision"},
          "label_event_type": {"const": "REQUEST_CHANGES"},
          "observed_review_issue_count": {"type": "integer", "minimum": 1}
        }
      }
    },
    {
      "if": {"properties": {"eligibility_cohort": {"const": "administrative"}}},
      "then": {
        "properties": {
          "label_event_type": {"enum": ["DUPLICATE", "SPAM", "SUPERSEDED", "ABANDONED", "AUTHOR_CLOSED", "BOT_ONLY", "MERGED_WITHOUT_REVIEW", "CLOSED_WITHOUT_REVIEW"]},
          "rationale_eligible": {"const": false},
          "observed_review_issue_count": {"type": "null"},
          "split": {"const": "unassigned"},
          "exclusion_reason": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"eligibility_cohort": {"enum": ["excluded", "unknown"]}}},
      "then": {
        "properties": {
          "rationale_eligible": {"const": false},
          "observed_review_issue_count": {"type": "null"},
          "eligibility_reason": {"type": "null"},
          "exclusion_reason": {"type": "string", "minLength": 1},
          "split": {"const": "unassigned"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "commitSha": {"type": "string", "pattern": "^[a-f0-9]{40}$"}
  }
}
