{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents-v3/artifact_resolution.schema.json",
  "title": "Final profile artifact resolution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "artifacts"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_path", "relative_path"],
        "properties": {
          "profile_path": {"type": "string", "minLength": 1},
          "relative_path": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
