{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agents-v3/runtime_capability_report.schema.json",
  "title": "Runtime Capability Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "generated_at", "generated_by", "run_config_sha256", "capability_manifest_sha256", "launcher_attestation", "manifest_sha256", "all_required_probes_passed", "roles"],
  "properties": {
    "schema_version": {"const": "3.0.0"},
    "run_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "generated_by": {"type": "string", "minLength": 1},
    "run_config_sha256": {"$ref": "#/$defs/sha256"},
    "capability_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "launcher_attestation": {"$ref": "#/$defs/launcherAttestation"},
    "manifest_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "all_required_probes_passed": {"type": "boolean"},
    "roles": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"$ref": "#/$defs/role"}}
  },
  "allOf": [
    {"properties": {"roles": {"contains": {"properties": {"role": {"const": "collector"}}, "required": ["role"]}}}},
    {"properties": {"roles": {"contains": {"properties": {"role": {"const": "train_evidence_miner"}}, "required": ["role"]}}}},
    {"properties": {"roles": {"contains": {"properties": {"role": {"const": "candidate_worker"}}, "required": ["role"]}}}},
    {"properties": {"roles": {"contains": {"properties": {"role": {"const": "judge"}}, "required": ["role"]}}}},
    {"properties": {"roles": {"contains": {"properties": {"role": {"const": "artifact_evaluator"}}, "required": ["role"]}}}},
    {"properties": {"roles": {"contains": {"properties": {"role": {"const": "dev_evaluator"}}, "required": ["role"]}}}},
    {"properties": {"roles": {"contains": {"properties": {"role": {"const": "final_test_evaluator"}}, "required": ["role"]}}}},
    {"properties": {"roles": {"contains": {"properties": {"role": {"const": "untrusted_code_runner"}}, "required": ["role"]}}}},
    {
      "if": {"properties": {"all_required_probes_passed": {"const": true}}, "required": ["all_required_probes_passed"]},
      "then": {
        "properties": {
          "roles": {
            "items": {
              "properties": {
                "probes": {
                  "properties": {
                    "github_read_only": {"const": true},
                    "github_write_denied": {"const": true},
                    "unauthorized_truth_paths_absent": {"const": true},
                    "host_home_absent": {"const": true},
                    "runtime_socket_absent": {"const": true},
                    "path_escape_denied": {"const": true}
                  }
                }
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "launcherAttestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_sha256", "nonce", "report_hmac_sha256"],
      "properties": {
        "algorithm": {"const": "HMAC-SHA256"},
        "key_sha256": {"$ref": "#/$defs/sha256"},
        "nonce": {"type": "string", "minLength": 16, "maxLength": 256},
        "report_hmac_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "role": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "process_identity", "executable", "image_digest", "network", "mounts", "writable_paths", "environment_variable_names", "secret_mounts", "sockets", "devices", "resource_limits", "probes"],
      "properties": {
        "role": {"enum": ["collector", "train_evidence_miner", "candidate_worker", "judge", "artifact_evaluator", "dev_evaluator", "final_test_evaluator", "untrusted_code_runner"]},
        "process_identity": {"type": "string", "minLength": 1}, "executable": {"type": "string", "minLength": 1}, "image_digest": {"type": ["string", "null"], "pattern": "^sha256:[a-f0-9]{64}$"},
        "network": {"$ref": "#/$defs/network"}, "mounts": {"type": "array", "items": {"$ref": "#/$defs/mount"}},
        "writable_paths": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^/"}},
        "environment_variable_names": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"}},
        "secret_mounts": {"type": "array", "maxItems": 0}, "sockets": {"type": "array", "maxItems": 0}, "devices": {"type": "array", "maxItems": 0},
        "resource_limits": {"$ref": "#/$defs/limits"}, "probes": {"$ref": "#/$defs/probes"}
      }
    },
    "network": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "allowed_hosts", "allowed_methods"],
      "properties": {"mode": {"enum": ["none", "allowlist", "provider_proxy_only"]}, "allowed_hosts": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "allowed_methods": {"type": "array", "uniqueItems": true, "items": {"enum": ["GET", "POST"]}}}
    },
    "mount": {
      "type": "object", "additionalProperties": false,
      "required": ["source_id", "class", "target", "access"],
      "properties": {"source_id": {"type": "string", "minLength": 1}, "class": {"type": "string", "minLength": 1}, "target": {"type": "string", "pattern": "^/"}, "access": {"enum": ["ro", "rw", "wo"]}}
    },
    "limits": {
      "type": "object", "additionalProperties": false,
      "required": ["cpus", "memory_mb", "pids", "disk_mb", "output_mb", "wall_clock_seconds"],
      "properties": {"cpus": {"type": "number", "exclusiveMinimum": 0}, "memory_mb": {"type": "integer", "minimum": 64}, "pids": {"type": "integer", "minimum": 1}, "disk_mb": {"type": "integer", "minimum": 1}, "output_mb": {"type": "integer", "minimum": 1}, "wall_clock_seconds": {"type": "integer", "minimum": 1}}
    },
    "probes": {
      "type": "object", "additionalProperties": false,
      "required": ["github_read_only", "github_write_denied", "unauthorized_truth_paths_absent", "host_home_absent", "runtime_socket_absent", "path_escape_denied"],
      "properties": {"github_read_only": {"type": "boolean"}, "github_write_denied": {"type": "boolean"}, "unauthorized_truth_paths_absent": {"type": "boolean"}, "host_home_absent": {"type": "boolean"}, "runtime_socket_absent": {"type": "boolean"}, "path_escape_denied": {"type": "boolean"}}
    }
  }
}
